include_guard(GLOBAL)
if(NOT TARGET NullusPluginSDK)
    add_library(NullusPluginSDK INTERFACE)
    target_include_directories(NullusPluginSDK INTERFACE "${CMAKE_CURRENT_LIST_DIR}")
endif()

function(nullus_validate_binary_plugin target)
    set(_pending "${target}")
    set(_visited "")
    set(_forbidden NLS_Base NLS_Core NLS_Platform NLS_Plugins NLS_Engine NLS_Render NLS_UI NLS_Scripting NLS_Packages EditorProject GameProject)
    while(_pending)
        list(POP_FRONT _pending _current)
        if(_current IN_LIST _visited OR NOT TARGET "${_current}")
            continue()
        endif()
        if(_current IN_LIST _forbidden)
            message(FATAL_ERROR "Binary Plugin ${target} links ${_current}. Independent binaries must use the Host API and NullusPluginSDK only for engine access.")
        endif()
        list(APPEND _visited "${_current}")
        get_target_property(_direct "${_current}" LINK_LIBRARIES)
        get_target_property(_interface "${_current}" INTERFACE_LINK_LIBRARIES)
        string(REGEX MATCHALL "[A-Za-z_][-A-Za-z0-9_.]*(::[A-Za-z_][-A-Za-z0-9_.]*)*" _tokens "${_direct};${_interface}")
        foreach(_token IN LISTS _tokens)
            if(TARGET "${_token}")
                list(APPEND _pending "${_token}")
            endif()
        endforeach()
    endwhile()
endfunction()

function(nullus_add_binary_plugin target)
    if(NOT target MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        message(FATAL_ERROR "Invalid binary plugin target name")
    endif()
    add_library(${target} MODULE ${ARGN})
    target_link_libraries(${target} PRIVATE NullusPluginSDK)
    set_target_properties(${target} PROPERTIES PREFIX "" C_VISIBILITY_PRESET hidden CXX_VISIBILITY_PRESET hidden)
    # Deferred so later target_link_libraries calls cannot accidentally bypass
    # the SDK boundary by bringing a static engine copy into the DLL.
    cmake_language(EVAL CODE "cmake_language(DEFER CALL nullus_validate_binary_plugin ${target})")
endfunction()
