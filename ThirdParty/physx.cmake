# Keep the SDK's configuration and compiler flags in its own directory scope.
include(FetchContent)

set(NLS_PHYSX_SOURCE_DIR "" CACHE PATH "Optional PhysX 5.6.1 source checkout (directory containing physx)")

function(nls_add_physx_sdk)
    if(POLICY CMP0135)
        cmake_policy(SET CMP0135 NEW)
    endif()
    if(NLS_PHYSX_SOURCE_DIR)
        set(_physx_source "${NLS_PHYSX_SOURCE_DIR}")
    else()
        FetchContent_Declare(nullus_physx
            URL https://codeload.github.com/NVIDIA-Omniverse/PhysX/zip/09ff24f3279b735e672ff27b155cbf49f6296f4d
            URL_HASH SHA256=d6d112ae8ed3de7c0478ef87d49e5423c8a364d72b2ba5d349115d57e863b6e2
            DOWNLOAD_NAME physx-5.6.1.zip
            DOWNLOAD_DIR "${CMAKE_BINARY_DIR}/_deps"
            SOURCE_SUBDIR nullus-download-only
        )
        FetchContent_MakeAvailable(nullus_physx)
        set(_physx_source "${nullus_physx_SOURCE_DIR}")
    endif()
    if(NOT EXISTS "${_physx_source}/physx/include/PxPhysicsAPI.h")
        message(FATAL_ERROR "NLS_PHYSX_SOURCE_DIR must contain a PhysX source checkout")
    endif()
    file(READ "${_physx_source}/physx/include/foundation/PxPhysicsVersion.h" _physx_version)
    foreach(_version_part "MAJOR;5" "MINOR;6" "BUGFIX;1")
        list(GET _version_part 0 _part)
        list(GET _version_part 1 _expected)
        if(NOT _physx_version MATCHES "#define[ \t]+PX_PHYSICS_VERSION_${_part}[ \t]+${_expected}([\r\n]|$)")
            message(FATAL_ERROR "Nullus requires the pinned PhysX 5.6.1 SDK")
        endif()
    endforeach()
    set(PHYSX_ROOT_DIR "${CMAKE_BINARY_DIR}/_deps/physx-sdk-source")
    if(NOT EXISTS "${PHYSX_ROOT_DIR}/include/PxPhysicsAPI.h")
        file(COPY "${_physx_source}/physx/" DESTINATION "${PHYSX_ROOT_DIR}")
    endif()
    # The CPU SDK must not copy the standalone sample's freeglut DLLs.
    set(_platform_cmake "${PHYSX_ROOT_DIR}/source/compiler/cmake/windows/CMakeLists.txt")
    file(READ "${_platform_cmake}" _platform_source)
    string(REPLACE "IF(PX_COPY_EXTERNAL_DLL OR PUBLIC_RELEASE)" "IF(PX_COPY_EXTERNAL_DLL)"
        _platform_patched "${_platform_source}")
    if(NOT _platform_source STREQUAL _platform_patched)
        file(WRITE "${_platform_cmake}" "${_platform_patched}")
    endif()
    set(_nullus_configurations "${CMAKE_CONFIGURATION_TYPES}")
    if(APPLE)
        set(_mac_platform "${PHYSX_ROOT_DIR}/source/compiler/cmake/mac")
        if(NOT EXISTS "${_mac_platform}/CMakeLists.txt")
            file(COPY "${PHYSX_ROOT_DIR}/source/compiler/cmake/linux/" DESTINATION "${_mac_platform}")
        endif()
        # Darwin size_t is unsigned long while uint64_t is unsigned long long.
        # Select the 64-bit overload explicitly without truncating the promoted sum.
        set(_temp_allocator_file "${PHYSX_ROOT_DIR}/source/foundation/FdTempAllocator.cpp")
        file(READ "${_temp_allocator_file}" _temp_allocator_source)
        string(REPLACE "PxHighestSetBit(PxU32(size) + sizeof(Chunk) - 1)"
            "PxHighestSetBit(static_cast<uint64_t>(PxU32(size) + sizeof(Chunk) - 1))"
            _temp_allocator_patched "${_temp_allocator_source}")
        if(NOT _temp_allocator_source STREQUAL _temp_allocator_patched)
            file(WRITE "${_temp_allocator_file}" "${_temp_allocator_patched}")
        endif()
        set(_thread_file "${PHYSX_ROOT_DIR}/source/foundation/unix/FdUnixThread.cpp")
        file(READ "${_thread_file}" _thread_source)
        string(REPLACE "threadImpl.tid = syscall(SYS_gettid);"
            "uint64_t nativeThreadId = 0;\n\tpthread_threadid_np(NULL, &nativeThreadId);\n\tthreadImpl.tid = static_cast<pid_t>(nativeThreadId);"
            _thread_patched "${_thread_source}")
        if(NOT _thread_source STREQUAL _thread_patched)
            file(WRITE "${_thread_file}" "${_thread_patched}")
        endif()
        set(TARGET_BUILD_PLATFORM mac)
    elseif(WIN32)
        set(TARGET_BUILD_PLATFORM windows)
    else()
        # PhysX's Unix implementation still has explicit Apple branches.
        set(TARGET_BUILD_PLATFORM linux)
    endif()
    set(PX_GENERATE_STATIC_LIBRARIES ON CACHE BOOL "Build the PhysX CPU SDK statically" FORCE)
    set(PX_GENERATE_GPU_PROJECTS OFF CACHE BOOL "VFX GPU simulation uses the engine RHI" FORCE)
    set(PX_GENERATE_GPU_PROJECTS_ONLY OFF CACHE BOOL "Build the CPU SDK" FORCE)
    set(PX_BUILDSNIPPETS OFF CACHE BOOL "PhysX snippets" FORCE)
    set(PX_BUILDPVDRUNTIME OFF CACHE BOOL "PhysX external OmniPVD runtime" FORCE)
    set(PX_COPY_EXTERNAL_DLL OFF CACHE BOOL "No PhysX sample DLL dependencies" FORCE)
    set(NV_USE_STATIC_WINCRT OFF CACHE BOOL "Match the engine's dynamic MSVC runtime" FORCE)
    set(NV_USE_DEBUG_WINCRT ON CACHE BOOL "Use the debug CRT in Debug" FORCE)
    set(PX_OUTPUT_LIB_DIR "${CMAKE_BINARY_DIR}/physx-sdk")
    set(PX_OUTPUT_BIN_DIR "${CMAKE_BINARY_DIR}/physx-sdk")
    add_subdirectory("${PHYSX_ROOT_DIR}/compiler/public" "${CMAKE_BINARY_DIR}/physx-sdk-build" EXCLUDE_FROM_ALL)
    if(_nullus_configurations)
        set(CMAKE_CONFIGURATION_TYPES "${_nullus_configurations}" CACHE STRING "Nullus build configurations" FORCE)
    endif()
    foreach(_target PhysXFoundation PhysXCommon PhysXCooking PhysX PhysXExtensions PhysXPvdSDK PhysXTask
            LowLevel LowLevelAABB LowLevelDynamics SceneQuery SimulationController PhysXCharacterKinematic PhysXVehicle PhysXVehicle2)
        if(TARGET ${_target})
            set_target_properties(${_target} PROPERTIES FOLDER "ThirdParty/PhysX" POSITION_INDEPENDENT_CODE ON
                CXX_STANDARD 14 CXX_STANDARD_REQUIRED ON)
            target_compile_definitions(${_target} PRIVATE
                $<$<CONFIG:RelWithDebInfo>:NDEBUG;PX_PROFILE=1;PX_SUPPORT_PVD=1;PX_SUPPORT_OMNI_PVD=0>)
            if(APPLE)
                target_compile_options(${_target} PRIVATE -Wno-error)
                foreach(_link_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
                    get_target_property(_libraries ${_target} ${_link_property})
                    if(_libraries)
                        list(REMOVE_ITEM _libraries rt dl "$<LINK_ONLY:rt>" "$<LINK_ONLY:dl>")
                        set_property(TARGET ${_target} PROPERTY ${_link_property} "${_libraries}")
                    endif()
                endforeach()
            endif()
        endif()
    endforeach()
    add_library(NLS_PhysX INTERFACE)
    target_include_directories(NLS_PhysX INTERFACE "${PHYSX_ROOT_DIR}/include")
    target_compile_definitions(NLS_PhysX INTERFACE PX_PHYSX_STATIC_LIB)
    target_link_libraries(NLS_PhysX INTERFACE PhysXExtensions PhysXCooking PhysX PhysXPvdSDK PhysXCommon PhysXFoundation)
endfunction()

nls_add_physx_sdk()
