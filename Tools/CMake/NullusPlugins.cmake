include_guard(GLOBAL)
set(NLS_PLUGIN_PROJECT_ROOT "" CACHE PATH "Project whose resolved Source Plugins are compiled into Editor/Game")

function(nls_plugin_package_fingerprint root output)
    file(GLOB_RECURSE _files CONFIGURE_DEPENDS LIST_DIRECTORIES TRUE "${root}/*")
    list(SORT _files)
    set(_inputs "")
    set(_count 0)
    set(_bytes 0)
    foreach(_file IN LISTS _files)
        if(_file MATCHES "/\\.git(/|$)")
            continue()
        endif()
        if(IS_SYMLINK "${_file}")
            message(FATAL_ERROR "Source Plugin build input refuses symbolic links: ${_file}")
        endif()
        if(IS_DIRECTORY "${_file}")
            continue()
        endif()
        file(SIZE "${_file}" _size)
        math(EXPR _count "${_count} + 1")
        math(EXPR _bytes "${_bytes} + ${_size}")
        if(_count GREATER 100000 OR _bytes GREATER 4294967296)
            message(FATAL_ERROR "Source Plugin build input limit exceeded")
        endif()
        file(SHA256 "${_file}" _hash)
        file(RELATIVE_PATH _relative "${root}" "${_file}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
        string(APPEND _inputs "${_relative}:${_hash}\n")
    endforeach()
    string(SHA256 _hash "${_inputs}")
    set(${output} "${_hash}" PARENT_SCOPE)
endfunction()

function(nls_prepare_source_plugins)
    set_property(GLOBAL PROPERTY NLS_SELECTED_PLUGIN_MANIFESTS "")
    if(NOT NLS_PLUGIN_PROJECT_ROOT)
        return()
    endif()
    file(REAL_PATH "${NLS_PLUGIN_PROJECT_ROOT}" _project)
    set(_packages "${_project}/Packages")
    # Exact globs also detect creation/removal of initially absent inputs.
    file(GLOB _inputs CONFIGURE_DEPENDS
        "${_packages}/manifest.json" "${_packages}/packages-lock.json"
        "${_packages}/plugins.json" "${_packages}/resolved-plugins.json"
        "${_packages}/build-trust.json" "${_project}/Plugins/*/plugin.json")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_inputs})
    if(NOT EXISTS "${_packages}/resolved-plugins.json")
        if(EXISTS "${_packages}/plugins.json")
            message(FATAL_ERROR "Plugin selection has not been resolved. Run NullusPlugins resolve for ${_project}.")
        endif()
        return()
    endif()
    file(READ "${_packages}/resolved-plugins.json" _resolved)
    foreach(_name manifest.json packages-lock.json plugins.json)
        string(JSON _expected ERROR_VARIABLE _error GET "${_resolved}" inputs "${_name}")
        if(_error OR NOT EXISTS "${_packages}/${_name}")
            message(FATAL_ERROR "Plugin build inputs are incomplete; run NullusPlugins resolve.")
        endif()
        file(SHA256 "${_packages}/${_name}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "Plugin ${_name} changed after resolution; run NullusPlugins resolve. Stale module registration is forbidden.")
        endif()
    endforeach()
    string(JSON _count LENGTH "${_resolved}" plugins)
    if(_count EQUAL 0)
        return()
    endif()
    math(EXPR _last "${_count} - 1")
    foreach(_index RANGE 0 ${_last})
        string(JSON _enabled GET "${_resolved}" plugins ${_index} enabled)
        if(NOT _enabled)
            continue()
        endif()
        string(JSON _manifest GET "${_resolved}" plugins ${_index} manifest)
        if(NOT IS_ABSOLUTE "${_manifest}" OR NOT EXISTS "${_manifest}")
            message(FATAL_ERROR "Resolved plugin manifest is missing: ${_manifest}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_manifest}")
        file(READ "${_manifest}" _plugin)
        string(JSON _id GET "${_plugin}" id)
        if(NOT _id MATCHES "^[a-z0-9]+([.-][a-z0-9]+)*$")
            message(FATAL_ERROR "Invalid resolved plugin ID")
        endif()
        string(JSON _modules LENGTH "${_plugin}" modules)
        set(_has_source FALSE)
        if(_modules GREATER 0)
            math(EXPR _module_last "${_modules} - 1")
            foreach(_module RANGE 0 ${_module_last})
                string(JSON _target ERROR_VARIABLE _error GET "${_plugin}" modules ${_module} sourceTarget)
                if(NOT _error)
                    set(_has_source TRUE)
                endif()
            endforeach()
        endif()
        if(_has_source)
            get_filename_component(_root "${_manifest}" DIRECTORY)
            # CMake may execute Python, PowerShell or package tools with any
            # filename. Trust the entire immutable package, never just *.cmake.
            nls_plugin_package_fingerprint("${_root}" _build_hash)
            if(NOT EXISTS "${_packages}/build-trust.json")
                message(FATAL_ERROR "Source Plugin ${_id} requires explicit build approval in NullusPlugins.")
            endif()
            file(READ "${_packages}/build-trust.json" _trust)
            string(JSON _trust_schema ERROR_VARIABLE _schema_error GET "${_trust}" schemaVersion)
            string(JSON _trusted ERROR_VARIABLE _error GET "${_trust}" packages "${_id}" buildHash)
            string(JSON _trusted_source ERROR_VARIABLE _source_error GET "${_trust}" packages "${_id}" source)
            string(JSON _trusted_scope ERROR_VARIABLE _scope_error GET "${_trust}" packages "${_id}" inputScope)
            string(JSON _selected_source ERROR_VARIABLE _selection_error GET "${_resolved}" plugins ${_index} source)
            if(_schema_error OR NOT _trust_schema EQUAL 1 OR _error OR NOT _trusted STREQUAL _build_hash OR
                _source_error OR _selection_error OR NOT _trusted_source STREQUAL _selected_source OR
                _scope_error OR NOT _trusted_scope STREQUAL "package-content-v1")
                message(FATAL_ERROR "Source Plugin ${_id} package content changed or is unapproved. Review and approve it before configuring. Build outputs must be outside the package.")
            endif()
            set_property(GLOBAL PROPERTY "NLS_APPROVED_SOURCE_HASH_${_id}" "${_build_hash}")
            add_subdirectory("${_root}" "${CMAKE_BINARY_DIR}/plugin-source/${_id}")
        endif()
        set_property(GLOBAL APPEND PROPERTY NLS_SELECTED_PLUGIN_MANIFESTS "${_manifest}")
    endforeach()
endfunction()

function(nls_attach_source_plugins target host)
    get_property(_manifests GLOBAL PROPERTY NLS_SELECTED_PLUGIN_MANIFESTS)
    set(NLS_SOURCE_PLUGIN_INCLUDES "")
    set(NLS_SOURCE_PLUGIN_REGISTRATIONS "")
    set(_records "{}")
    foreach(_manifest IN LISTS _manifests)
        file(READ "${_manifest}" _plugin)
        string(JSON _count LENGTH "${_plugin}" modules)
        if(_count EQUAL 0)
            continue()
        endif()
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _source ERROR_VARIABLE _error GET "${_plugin}" modules ${_index} sourceTarget)
            if(_error)
                continue()
            endif()
            string(JSON _type GET "${_plugin}" modules ${_index} type)
            if(host STREQUAL "Game" AND (_type STREQUAL "Editor" OR _type STREQUAL "Developer"))
                continue()
            endif()
            string(JSON _hosts ERROR_VARIABLE _host_error GET "${_plugin}" modules ${_index} hosts)
            if(NOT _host_error)
                string(JSON _host_count LENGTH "${_hosts}")
                set(_host_allowed FALSE)
                if(_host_count GREATER 0)
                    math(EXPR _host_last "${_host_count} - 1")
                    foreach(_host_index RANGE 0 ${_host_last})
                        string(JSON _declared_host GET "${_hosts}" ${_host_index})
                        if(_declared_host STREQUAL host)
                            set(_host_allowed TRUE)
                        endif()
                    endforeach()
                endif()
                if(NOT _host_allowed)
                    continue()
                endif()
            endif()
            if(NOT TARGET "${_source}")
                message(FATAL_ERROR "Source Plugin target is not declared: ${_source}")
            endif()
            get_target_property(_kind "${_source}" TYPE)
            get_target_property(_header "${_source}" NLS_MODULE_HEADER)
            get_target_property(_factory "${_source}" NLS_MODULE_FACTORY)
            if(NOT (_kind STREQUAL "STATIC_LIBRARY" OR _kind STREQUAL "OBJECT_LIBRARY") OR NOT _header OR NOT _factory)
                message(FATAL_ERROR "Source target ${_source} must be STATIC/OBJECT and declare NLS_MODULE_HEADER / NLS_MODULE_FACTORY")
            endif()
            if(NOT _factory MATCHES "^[A-Za-z_][A-Za-z0-9_:]*$" OR _header MATCHES "[\"\n\r]")
                message(FATAL_ERROR "Invalid Source Plugin factory/header")
            endif()
            string(APPEND NLS_SOURCE_PLUGIN_INCLUDES "#include \"${_header}\"\n")
            target_link_libraries(${target} PRIVATE "${_source}")
            get_filename_component(_root "${_manifest}" DIRECTORY)
            nls_plugin_package_fingerprint("${_root}" _input_hash)
            string(JSON _id GET "${_plugin}" id)
            get_property(_approved GLOBAL PROPERTY "NLS_APPROVED_SOURCE_HASH_${_id}")
            if(NOT _approved OR NOT _input_hash STREQUAL _approved)
                message(FATAL_ERROR "Source Plugin ${_id} changed during configuration. Keep build outputs outside the package.")
            endif()
            string(APPEND NLS_SOURCE_PLUGIN_REGISTRATIONS "    manager.AddSourceFactory(\"${_source}\", [] { return ${_factory}(); }, \"${_input_hash}\");\n")
            string(JSON _id GET "${_plugin}" id)
            string(JSON _version GET "${_plugin}" version)
            string(JSON _previous ERROR_VARIABLE _missing GET "${_records}" "${_id}")
            if(_missing)
                set(_previous "{\"version\":\"${_version}\",\"inputHash\":\"${_input_hash}\",\"targets\":[]}")
            endif()
            string(JSON _length LENGTH "${_previous}" targets)
            string(JSON _previous SET "${_previous}" targets ${_length} "\"${_source}\"")
            string(JSON _records SET "${_records}" "${_id}" "${_previous}")
        endforeach()
    endforeach()
    set(_registry "${CMAKE_CURRENT_BINARY_DIR}/${target}.SourcePlugins.cpp")
    configure_file("${NLS_ROOT_DIR}/Tools/CMake/SourcePluginRegistry.cpp.in" "${_registry}" @ONLY)
    target_sources(${target} PRIVATE "${_registry}")
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(_platform "macOS")
    else()
        set(_platform "${CMAKE_SYSTEM_NAME}")
    endif()
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "[Aa][Rr][Mm]64|aarch64" OR CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
        set(_arch arm64)
    else()
        set(_arch x64)
    endif()
    if(NOT NLS_ENGINE_VERSION_STRING)
        set(NLS_ENGINE_VERSION_STRING "1.0.0")
    endif()
    set(_record "${CMAKE_CURRENT_BINARY_DIR}/${target}.source-plugins-$<CONFIG>.json")
    file(GENERATE OUTPUT "${_record}" CONTENT "{\"schemaVersion\":1,\"platform\":\"${_platform}\",\"architecture\":\"${_arch}\",\"engineVersion\":\"${NLS_ENGINE_VERSION_STRING}\",\"compiler\":\"${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}\",\"configuration\":\"$<CONFIG>\",\"plugins\":${_records}}")
    add_custom_command(TARGET ${target} POST_BUILD COMMAND "${CMAKE_COMMAND}"
        "-DRECORD=${_record}" "-DBINARY=$<TARGET_FILE:${target}>" "-DDEST=$<TARGET_FILE_DIR:${target}>/${target}.source-plugins.json"
        -P "${NLS_ROOT_DIR}/Tools/CMake/WriteSourcePluginRecord.cmake" VERBATIM)
endfunction()
