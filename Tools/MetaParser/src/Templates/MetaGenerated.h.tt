<#@ template language="C#" hostspecific="true" #>
<#
    dynamic model = Session["Model"];
    string linkFunctionName = model.LinkFunctionName;
    string editorExtensionRegistrationFunctionName = model.EditorExtensionRegistrationFunctionName;
#>
#pragma once

namespace NLS::Editor::Inspector
{
class InspectorRegistry;
}

namespace NLS::meta_generated
{
void <#= linkFunctionName #>();
