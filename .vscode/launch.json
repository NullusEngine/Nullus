{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Nullus: C# Scripts",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:nullus.resolveEditorProcess}",
            "justMyCode": true,
            "requireExactSource": false,
            "enableStepFiltering": false,
            "sourceFileMap": {
                "${workspaceFolder}": "${workspaceFolder}"
            }
        },
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            // Resolved by CMake Tools:
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    // add the directory where our target was built to the PATHs
                    // it gets resolved by CMake Tools:
                    "name": "PATH",
                    "value": "$PATH:${command:cmake.launchTargetDirectory}"
                },
                {
                    "name": "OTHER_VALUE",
                    "value": "Something something"
                }
            ],
            "externalConsole": true,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Nullus: Lua Scripts",
            "type": "lua",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "luaFileExtension": ".lua",
            "connectionPort": 8818,
            "useCHook": false,
            "autoPathMode": true,
            "pathCaseSensitivity": false,
            "stopOnEntry": false
        },
        {
            "name": "Nullus: C# + Lua",
            "type": "compound",
            "configurations": [
                "Nullus: C# Scripts",
                "Nullus: Lua Scripts"
            ],
            "stopAll": true
        }
    ]
}
