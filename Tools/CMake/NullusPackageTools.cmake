include_guard(GLOBAL)
function(nls_configure_package_tools target)
    find_program(NLS_PACKAGE_GIT_EXECUTABLE NAMES git)
    find_program(NLS_PACKAGE_CURL_EXECUTABLE NAMES curl)
    if(NLS_PACKAGE_GIT_EXECUTABLE)
        target_compile_definitions(${target} PRIVATE NLS_PACKAGE_GIT="${NLS_PACKAGE_GIT_EXECUTABLE}")
    endif()
    if(NLS_PACKAGE_CURL_EXECUTABLE)
        target_compile_definitions(${target} PRIVATE NLS_PACKAGE_CURL="${NLS_PACKAGE_CURL_EXECUTABLE}")
    endif()
endfunction()
